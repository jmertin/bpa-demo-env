# Secret configuration and local build state - never commit
.config
.build_number

# Generated app archives
src/apache-php/app.tar.gz

# Broadcom DX O2 agent installers (binary, licensed, gitignored)
# Download from https://support.broadcom.com/ and place in this directory.
src/dx-o2-agents/installers/*
!src/dx-o2-agents/installers/.gitkeep

# Local tooling binaries - never commit (see tools/README.md)
tools/*

# dxo2-scripts runtime state (resource ids created in a specific tenant) -
# never commit; the scripts themselves are tracked
dxo2-scripts/.state/

# Helm local overrides
helm/php-demo/values.local.yaml

# Claude Code internal files
.claude/
RESUME

# Editor / OS artifacts
.DS_Store
*.swp
*.swo
*~
