#!/usr/bin/env bash
# Copy this file to .config and fill in real values.
# .config is excluded from git via .gitignore and must NEVER be committed.
# All build, push, deploy, and compose scripts read exclusively from this file.

# ── Docker Registry ───────────────────────────────────────────────────────────
REGISTRY="registry.example.com"
REGISTRY_USER="admin"
REGISTRY_PASSWORD="changeme"

# ── Image settings ────────────────────────────────────────────────────────────
IMAGE_PREFIX="dxo2-bpa-demo"
# Base version only – build.sh appends b<N> automatically (e.g. 1.0.0 → 1.0.0b4).
# The counter is stored in .build_number and updated on every build.sh run.
IMAGE_TAG="1.0.0"
BUILD_PLATFORM="linux/amd64"

# ── MariaDB credentials ───────────────────────────────────────────────────────
MARIADB_ROOT_PASSWORD="changeme_root"
MARIADB_DATABASE="phpapp"
MARIADB_USER="phpuser"
MARIADB_PASSWORD="changeme_user"

# ── Kubernetes / Helm deployment ──────────────────────────────────────────────
APP_NAMESPACE="dxo2-bpa-demo"
APP_HOSTNAME="dxo2-bpa-demo.example.com"
TLS_CLUSTER_ISSUER="letsencrypt-prod"
INGRESS_CLASS_NAME="nginx"          # e.g. nginx, traefik, haproxy, alb
KUBECONFIG="${HOME}/.kube/config"

# Path to the Helm chart directory.  Defaults to helm/dxo2-bpa-demo relative to the
# project root when this variable is absent or empty.
HELM_CHART_PATH=""

# ── Deployment identity ───────────────────────────────────────────────────────
# DEPLOYMENT_NAME + DEPLOYMENT_POSTFIX combine as "<name>-<postfix>" to form
# the default identity for every APMIA-based agent below (Infrastructure
# Agent, PHP probe, BPA WebServer plugin) -- e.g. "bpa-demo-k8s" or
# "bpa-demo-docker". This exists so running the Docker Compose deployment
# and the Helm/Kubernetes deployment against the SAME DX O2 tenant never
# collide: without a distinguishing postfix, both default to identical
# agent identity strings, and DX O2 disambiguates the second one to connect
# by appending a "%1" suffix -- which silently breaks any dashboard, alert,
# or metric-grouping query written against the plain (unsuffixed) name.
#
# DEPLOYMENT_NAME:     the logical application name (default "bpa-demo").
# DEPLOYMENT_POSTFIX:  leave empty to accept the per-script default --
#   build-scripts/compose.sh defaults to "docker", build-scripts/deploy.sh
#   defaults to "k8s". Override explicitly if you run more than one instance
#   of the same deployment mechanism (e.g. two Kubernetes clusters) and need
#   a third, distinct value.
#
# Every APMIA_* identity variable below (APMIA_AGENT_NAME, APMIA_APP_NAME,
# APMIA_HOST_NAME, APMIA_PROCESS_NAME, APMIA_PHP_AGENT_NAME,
# APMIA_WEB_AGENT_NAME) defaults to "${DEPLOYMENT_NAME}-${DEPLOYMENT_POSTFIX}"
# when left empty -- set any one of them explicitly to override just that
# agent's identity while leaving the others on the shared default.
DEPLOYMENT_NAME="bpa-demo"
DEPLOYMENT_POSTFIX=""

# ── Broadcom DX O2 Agent (APMIA) ─────────────────────────────────────────────
# These variables configure the Broadcom Infrastructure Agent container
# (dx-o2-agents image) and are also forwarded to the PHP-FPM and NGINX
# containers for opportunistic probe/plugin injection.
#
# DX O2 agent configuration.
#
# Installers must be downloaded from your DX O2 interface (NOT from
# support.broadcom.com).  The DX O2 download produces pre-configured packages
# with your tenant's EM URL and JWT credential already embedded.  See
# DX-O2-AGENT-SETUP.md for download instructions.
#
# APMIA_DEPLOY:     true (default) = run the IA from the dxo2 container.
#                   false = passive volume only (seed the agent tree but do
#                   not start the IA; use when the IA runs externally).
# APMIA_EM_HOST / APMIA_EM_PORT: Optional override for the EM connection.
#   When using the DX O2 installer these are pre-configured in the agent
#   profile and do NOT need to be set here.  Leave APMIA_EM_HOST empty.
# APMIA_AGENT_NAME / APMIA_APP_NAME / APMIA_HOST_NAME / APMIA_PROCESS_NAME /
# APMIA_PHP_AGENT_NAME / APMIA_WEB_AGENT_NAME: per-agent identity shown in the
#   EM console. Leave empty (as below) to use the DEPLOYMENT_NAME +
#   DEPLOYMENT_POSTFIX default above; set any one explicitly to override just
#   that agent.
# APMIA_LOG_LEVEL:  Agent log verbosity: DEBUG, INFO, WARN, or ERROR.
#   Maps to APMENV_LOG4J_LOGGER_INTROSCOPEAGENT="<level>, logfile".
#
# Same-pod IPC (Kubernetes – all containers share 127.0.0.1):
# APMIA_PHP_COLLECTOR_HOST / PORT: PHP probe → IA collector (port 5005 default).
# APMIA_BTL_HOST / PORT: BPA plugin → BTL (port 8000 default).
# Override host/port only when running the DX O2 agent in a separate pod.
#
# MYSQL_MONITOR:  true (default) = enable APMIA DB Monitor for MariaDB.
#   Requires the mysql extension to be installed in the dx-o2-agents image.
#   Place Infrastructure_Agent_apmia_*.tar in src/dx-o2-agents/installers/ and
#   rebuild -- the Dockerfile extracts the mysql-*.tar.gz from that archive.
#   Credentials come from MARIADB_USER / MARIADB_PASSWORD (above).
#   In Docker Compose the database is reached by service name "mariadb".
#   In Kubernetes all containers share 127.0.0.1.
#   The dxo2 entrypoint also uses MARIADB_ROOT_PASSWORD (above) to verify the
#   MARIADB_USER login exists in MariaDB, creating it with monitoring grants
#   (SELECT, PROCESS, REPLICATION CLIENT) if missing -- the DB Monitor
#   extension cannot authenticate or gather metrics without this login.
#
# Set APMIA_EM_HOST to a non-empty value to enable the DX O2 monitoring stack.
# Leave it empty to deploy without APM; all containers start cleanly without
# the agent volume mounted.
APMIA_DEPLOY="true"
APMIA_EM_HOST=""
APMIA_EM_PORT="8443"
APMIA_AGENT_NAME=""
APMIA_APP_NAME=""
APMIA_HOST_NAME=""
APMIA_PROCESS_NAME=""
APMIA_PHP_AGENT_NAME=""
APMIA_WEB_AGENT_NAME=""
APMIA_LOG_LEVEL="INFO"
# PHP probe log level (wily_php_agent.logLevel).  Controls verbosity of the
# PHP probe log written to /var/log/php-probe/.
# Accepts names or numeric values: 0=TRACE, 1=DEBUG, 2=INFO (default), 3=WARNING, 4=ERROR, 5=FATAL
# The entrypoint maps names to the numeric value the INI requires.  Use INFO for normal operation.
APMIA_PHP_LOG_LEVEL="INFO"
APMIA_PHP_COLLECTOR_HOST="127.0.0.1"
APMIA_PHP_COLLECTOR_PORT="5005"
APMIA_BTL_HOST="127.0.0.1"
APMIA_BTL_PORT="8000"
MYSQL_MONITOR="true"

# ── DX O2 Browser Agent auto-injection ───────────────────────────────────────
# Snippet string from your DX O2 tenant: DX O2 Settings → Manage Mobile/Browser Web Monitoring → App to Monitor → Web App.
# Typically a <script> tag referencing the tenant-specific JavaScript URL.
# When set, the PHP probe injects the snippet into every HTML response automatically
# (wily_php_agent.browseragent.autoInjection).  Leave empty to disable.
#
# MUST use single quotes: the snippet value contains double-quotes (HTML attributes
# in the <script> tag).  Double-quoting the variable would cause the shell to
# interpret those inner double-quotes as string terminators, corrupting the value.
# Single quotes preserve the content exactly as-is, including all double-quotes.
#
# Example:
#   APMIA_BROWSER_SNIPPET='<script src="https://example.apm.broadcom.com/snippet.js"></script>'
#
# If a snippet is already present below (not the empty '' default), it has
# most likely been populated by dxo2-scripts/bpa-demo-axa-app.sh's `create`
# command, which creates the "BPA Demo AXA" DX O2 AXA application and syncs
# its BrowserAgent snippet here automatically -- see that script's header
# comment and dxo2-scripts/README.md's AXA section. Safe to commit: unlike
# every other value in this file, a BA snippet is a client-side <script> tag
# meant to be embedded in every page (visible via view-source), not a secret.
APMIA_BROWSER_SNIPPET='<script type="text/javascript" id="ca_eum_ba" src="https://dxc.dxi-eu1.saas.broadcom.com/api/1/urn:ca:tenantId:CA629949-9D34-4BA7-B198-0335025F4AF3/urn:ca:appId:BPA Demo AXA/bajs?agent=browser" data-profileUrl="https://dxc.dxi-eu1.saas.broadcom.com/api/1/urn:ca:tenantId:CA629949-9D34-4BA7-B198-0335025F4AF3/urn:ca:appId:BPA Demo AXA/profile?agent=browser" data-tenantID="CA629949-9D34-4BA7-B198-0335025F4AF3" data-appID="BPA Demo AXA" data-appVersion="1.0" data-use-axa-appname="true" data-appKey="4ab13890-9fa3-11f1-b11a-cb298d633a77" async ></script>'

# ── Traffic generator ────────────────────────────────────────────────────────
# Synthetic user traffic for the demo shop (see traffic-generator/README.md).
# Cycles through the full demo user roster (including trouble/empty_basket/
# locked) so their use cases fire regularly without a human clicking through
# the app.
#
# TRAFFIC_ENABLED: true (default) = generate traffic; false = container stays
#   up but idle (same pattern as APMIA_DEPLOY above).
# TRAFFIC_MIN/MAX_ACTION_DELAY_SECS: pause between actions within one session.
# TRAFFIC_MIN/MAX_SESSION_DELAY_SECS: pause between one user's session and the next.
# TRAFFIC_ANONYMOUS_RATIO: fraction of each cycle's sessions that browse
#   anonymously, no login (default 0.8 = 80%) -- the remaining share is
#   always exactly one authenticated session per demo user, so
#   trouble/empty_basket/locked still fire every cycle regardless.
# TRAFFIC_CONCURRENT_SESSIONS: how many sessions run in parallel (default 3).
#   Real traffic overlaps; without this every session runs strictly one at
#   a time and response-time averages stay artificially flat.
# TRAFFIC_SLOWDOWN_PROBABILITY / MIN/MAX_SECS: chance (default 12%) that a
#   given action's pacing gets an extra randomized delay on top, simulating
#   an occasional slow client/network burst.
# TRAFFIC_LOG_LEVEL: DEBUG logs every request; INFO (default) logs per-session
#   summaries and notable outcomes (e.g. a blocked login) only.
TRAFFIC_ENABLED="true"
TRAFFIC_MIN_ACTION_DELAY_SECS="1"
TRAFFIC_MAX_ACTION_DELAY_SECS="4"
TRAFFIC_MIN_SESSION_DELAY_SECS="2"
TRAFFIC_MAX_SESSION_DELAY_SECS="8"
TRAFFIC_ANONYMOUS_RATIO="0.8"
TRAFFIC_CONCURRENT_SESSIONS="3"
TRAFFIC_SLOWDOWN_PROBABILITY="0.12"
TRAFFIC_SLOWDOWN_MIN_SECS="3"
TRAFFIC_SLOWDOWN_MAX_SECS="12"
TRAFFIC_LOG_LEVEL="INFO"
