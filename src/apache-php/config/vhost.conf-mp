<VirtualHost *:8080>
    ServerAdmin webmaster@localhost
    DocumentRoot /var/www/html

    DirectoryIndex index.php index.html

    <Directory /var/www/html>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted

        RewriteEngine On
        # Redirect the bare root to /shop so the probe sees a meaningful URL segment.
        # Built as an absolute URL from the client-facing scheme + Host header,
        # not a bare "/shop" substitution. Apache itself only ever serves plain
        # HTTP on :8080 -- it has no idea a reverse proxy (Traefik/Ingress) is
        # terminating TLS in front of it. A relative substitution on an [R]
        # redirect forces Apache to build the absolute Location header itself
        # via ap_construct_url(), which uses ITS OWN scheme (http) and ITS OWN
        # listen port (8080, non-default for http) -- producing a public-facing
        # "http://host:8080/shop" redirect that is wrong on both counts.
        # Traefik sets X-Forwarded-Proto: https on TLS-terminated requests;
        # detect that (or a directly-terminated HTTPS connection, e.g. mod_ssl
        # in a non-Traefik deployment) to pick the right scheme, and use
        # %{HTTP_HOST} (the original Host header -- already portless when the
        # client used the scheme's default port) instead of Apache's own port.
        RewriteCond %{HTTP:X-Forwarded-Proto} =https [OR]
        RewriteCond %{HTTPS} =on
        RewriteRule ^$ https://%{HTTP_HOST}/shop [R=302,L]
        RewriteRule ^$ http://%{HTTP_HOST}/shop [R=302,L]
        # Route clean page URLs through per-page wrapper files.
        # Each wrapper (shop.php, basket.php, etc.) contains one non-include opcode
        # before its require of index.php -- this causes the PHP probe to establish
        # "Frontend start: /shop.php" rather than treating the file as an include
        # chain.  Without this, SCRIPT_NAME=/index.php is a null segment and the
        # probe skips browser-agent injection.
        # REQUEST_URI stays as /shop, /basket, etc. -- the probe names its BA cookie
        # from REQUEST_URI's last segment (x-apm-brtm-response-bt-page-shop).
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteRule ^([a-z][a-z0-9_-]*)$ /$1.php?page=$1 [L,QSA]
    </Directory>

    # Prevent caching at all layers: PHP OPcache is disabled at the PHP level
    # (Dockerfile ini drop-in).  These headers cover web-server and browser caching.
    # mod_headers is enabled (Dockerfile: a2enmod headers).
    # "always" ensures headers are sent even on error responses (4xx/5xx).
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    # Strip ETags and Last-Modified so browsers cannot use conditional GETs
    # to serve stale content from their own cache.
    Header unset ETag
    Header unset Last-Modified
    FileETag None

    # Health check endpoint for Kubernetes liveness/readiness/startup probes.
    # Apache serves /health as a static file -- no PHP handler is invoked, so
    # the APMIA PHP probe extension is never triggered during health checks.
    # This keeps probes independent of whether the dx-o2-agent sidecar is ready.
    SetEnvIf Request_URI "^/health$" dontlog

    # Block web access to CLI-only setup scripts.
    <Location /setup/>
        Require all denied
    </Location>

    # Deny access to hidden files and directories (.git, .htaccess, etc.).
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    # Log to container stdout/stderr so the runtime captures them.
    # Probe requests to /health are suppressed (dontlog) to reduce noise.
    ErrorLog  /proc/self/fd/2
    CustomLog /proc/self/fd/1 combined env=!dontlog
</VirtualHost>
